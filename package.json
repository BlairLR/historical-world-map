{
  "name": "historical-world-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本地历史世界地图 — 2D 世界历史疆域时间轴",
  "scripts": {
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "data:relations": "node scripts/lib/relations-build.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "6.12.0",
    "polygon-clipping": "0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
